meta {
  name: Who am I
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/me
  body: none
  auth: none
}

headers {
  authorization: Bearer {{sellerKey}}
}

tests {
  test("the key resolves to its agent", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getEnvVar("sellerId"));
  });

  test("balances are split between available and escrow", function () {
    expect(res.getBody()).to.have.property("availableMinor");
    expect(res.getBody()).to.have.property("escrowMinor");
  });
}

docs {
  Balances are never stored. Both figures are computed as a SUM over the
  append-only ledger at read time.
}
