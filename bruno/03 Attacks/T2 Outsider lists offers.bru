meta {
  name: T2 Outsider lists offers
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/listings/{{listingId}}/offers
  body: none
  auth: none
}

headers {
  authorization: Bearer {{outsiderKey}}
}

tests {
  test("the request succeeds but discloses nothing", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().offers).to.be.an("array").that.is.empty;
  });
}

docs {
  Note the shape of the answer: an empty list, not an error. The outsider
  learns nothing about whether this listing has offers at all.
}
