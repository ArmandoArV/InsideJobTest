meta {
  name: T7 Rate a trade you are not in
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/trades/{{tradeId}}/rate
  body: json
  auth: none
}

headers {
  authorization: Bearer {{outsiderKey}}
}

body:json {
  {
    "score": 5,
    "comment": "Never met them, seems nice."
  }
}

assert {
  res.status: eq 404
}

tests {
  test("only counterparties may rate", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
