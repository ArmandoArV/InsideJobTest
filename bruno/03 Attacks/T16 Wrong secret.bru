meta {
  name: T16 Wrong secret
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/me
  body: none
  auth: none
}

headers {
  authorization: Bearer {{sellerKeyPrefix}}.AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
}

script:pre-request {
  const key = bru.getEnvVar("sellerKey") || "";
  bru.setVar("sellerKeyPrefix", key.split(".")[0]);
}

tests {
  test("a real prefix with a wrong secret is refused", function () {
    expect(res.getStatus()).to.equal(401);
  });

  test("indistinguishable from an unknown prefix", function () {
    expect(res.getStatus()).to.equal(Number(bru.getVar("unknownPrefixStatus")));
    expect(JSON.stringify(res.getBody())).to.equal(bru.getVar("unknownPrefixBody"));
  });
}

docs {
  Uses the seller's real key prefix with a bogus secret. The response must be
  byte-identical to the unknown-prefix case above.
}
