meta {
  name: T5 Seller releases own escrow
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/trades/{{tradeId}}/confirm-delivery
  body: none
  auth: none
}

headers {
  authorization: Bearer {{sellerKey}}
  Idempotency-Key: {{idem}}
}

script:pre-request {
  bru.setVar("idem", "bru-attack-" + Date.now() + "-" + Math.floor(Math.random() * 1e6));
}

tests {
  test("the seller cannot confirm delivery", function () {
    expect(res.getStatus()).to.be.oneOf([404, 409]);
  });
}

docs {
  `confirm_delivery` is **buyer-only** in the transition table, which is keyed on
  (state, event, role). The seller finds no transition and is refused.

  For the strictest reading, run this between "6 Seller ships" and "7 Buyer
  confirms delivery". After settlement it is refused anyway, but as a
  terminal-state conflict rather than a role violation — the same answer for a
  different reason, which is deliberate: the refusal never says which check
  failed.
}
