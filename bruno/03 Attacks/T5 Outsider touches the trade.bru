meta {
  name: T5 Outsider touches the trade
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/trades/{{tradeId}}/confirm-delivery
  body: none
  auth: none
}

headers {
  authorization: Bearer {{outsiderKey}}
  Idempotency-Key: {{idem}}
}

script:pre-request {
  bru.setVar("idem", "bru-attack-" + Date.now() + "-" + Math.floor(Math.random() * 1e6));
}

assert {
  res.status: eq 404
}

tests {
  test("a non-counterparty cannot touch the trade at all", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
