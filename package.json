{
  "name": "agentbazaar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "dotenv -e .env.local -- tsx scripts/migrate.ts",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "abuse": "dotenv -e .env.local -- tsx scripts/abuse.ts",
    "simulate": "dotenv -e .env.local -- tsx scripts/simulate.ts",
    "bruno": "cd bruno && bru run --env production -r",
    "bruno:local": "cd bruno && bru run --env local -r",
    "verify:csp": "tsx scripts/verify-csp.ts",
    "verify:sweep": "dotenv -e .env.local -- tsx scripts/verify-sweep.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.4",
    "@vercel/schedules": "^0.0.3",
    "ai": "^7.0.182",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@usebruno/cli": "^4.4.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
